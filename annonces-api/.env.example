NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://annonces:annonces@localhost:5432/annonces
REDIS_URL=redis://localhost:6379

# Générer chaque secret avec : openssl rand -hex 32
JWT_ACCESS_SECRET=remplacez-moi-par-64-caracteres-aleatoires-minimum-xxxxxxxxxxxxxxxx
OTP_SECRET=remplacez-moi-par-64-caracteres-aleatoires-minimum-yyyyyyyyyyyyyyyy

# 'console' affiche le code dans les logs (développement uniquement)
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMS_PROVIDER=infobip
# INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
# INFOBIP_API_KEY=
# INFOBIP_SENDER=Okazo

CORS_ORIGINS=http://localhost:3001
APP_NAME=Annonces

# Stockage des photos. Valeurs ci-dessous = MinIO local (docker compose).
# En production : Cloudflare R2 (S3_REGION=auto, S3_FORCE_PATH_STYLE=false)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=annonces-media
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/annonces-media

# Modération
MODERATION_TRUSTED_AFTER=3
RUN_MODERATION_WORKER=true
REPORTS_DAILY_LIMIT=20
VERIFICATIONS_DAILY_LIMIT=3
RUN_MAINTENANCE_WORKER=true
FAVORITES_MAX=500

# Production : bucket privé séparé (pièces d'identité, photos non modérées)
# S3_PRIVATE_BUCKET=annonces-private
# Relais dont l'API accepte X-Forwarded-For (réseau Docker privé en production)
TRUSTED_PROXIES=loopback,uniquelocal

# Code de connexion par WhatsApp (API WhatsApp Business Cloud de Meta) : console (développement), meta, none
WHATSAPP_PROVIDER=console
# E-mails (connexion par e-mail et mot de passe) : console en développement, fournisseur réel à choisir avant la bêta
MAIL_PROVIDER=console
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=code_verification
# WHATSAPP_TEMPLATE_LANG=fr

# Connexion avec Google : identifiants clients OAuth (site, Android, iOS), séparés par des virgules
GOOGLE_CLIENT_IDS=
# Connexion avec Facebook (application Meta Developers)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
