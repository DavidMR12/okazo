# Copier en .env sur le serveur (chmod 600). Ne jamais le versionner.
# Secrets : bash scripts/generate-secrets.sh >> .env  (puis supprimer les lignes vides correspondantes)

# ---- Marque et domaine ----
DOMAIN=votre-domaine.com
APP_NAME=Okazo
DEFAULT_COUNTRY=cm

# ---- Secrets (générés) ----
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
OTP_SECRET=

# ---- SMS ----
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Plafond de SMS par jour (protection contre les attaques qui font exploser la facture)
OTP_DAILY_GLOBAL_CAP=5000

# ---- WhatsApp, e-mail et Google (none ou vide tant que ce n'est pas configuré) ----
WHATSAPP_PROVIDER=none
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
MAIL_PROVIDER=none
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=

# ---- Cloudflare R2 (photos) ----
R2_ACCOUNT_ID=
R2_PUBLIC_BUCKET=annonces-media
R2_PRIVATE_BUCKET=annonces-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- Sauvegardes ----
R2_BACKUP_BUCKET=annonces-backups
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# Clé publique « age » (age1…) : chiffre chaque sauvegarde. La clé privée ne va PAS sur le serveur.
BACKUP_AGE_RECIPIENT=
# Facultatif : URL « heartbeat » d'un service de surveillance, appelée après chaque sauvegarde réussie
BACKUP_HEARTBEAT_URL=

# ---- Cloudflare Tunnel ----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Google AdSense (vide tant que le compte n'est pas approuvé) ----
ADSENSE_CLIENT=
ADSENSE_SLOT_FEED=
ADSENSE_SLOT_LISTING=
