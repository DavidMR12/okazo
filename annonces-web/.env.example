# Adresse de l'API, utilisée par le serveur Next.js (jamais exposée au navigateur)
API_URL=http://localhost:3000

# Adresse publique du site (liens canoniques, plan du site, partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME=Okazo
NEXT_PUBLIC_DEFAULT_COUNTRY=cm

# Origine des photos (bucket / CDN) : seules ces images sont gardées hors ligne
NEXT_PUBLIC_MEDIA_ORIGIN=http://localhost:9000

# Google AdSense (laisser vide tant que le compte n'est pas approuvé : aucune publicité ne s'affiche)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=

# Connexion avec Google et Facebook (boutons masqués si vides). Le même identifiant Google doit figurer dans GOOGLE_CLIENT_IDS de l'API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
