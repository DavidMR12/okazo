# Adresse de l'API. Sur un téléphone physique, utilisez l'IP de votre ordinateur sur le Wi-Fi
# (ex. http://192.168.1.20:3000), pas "localhost". Émulateur Android : http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Connexion avec Google et Facebook (boutons masqués si vides ; ne fonctionne pas dans Expo Go, il faut l'application installée)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Adresse du site Okazo : pages « Conditions d'utilisation » et « Confidentialité » ouvertes depuis l'application
EXPO_PUBLIC_SITE_URL=http://192.168.1.20:3001
